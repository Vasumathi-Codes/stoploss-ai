// STOPLOSS AI — PostgreSQL schema.
//
// Enum values deliberately match the string unions in the frontend's
// `src/types/index.ts`, so rows map to UI types without translation.
//
// Deliberately absent: passwords, UPI PINs, OTPs, CVVs, full card numbers and
// banking logins. Evidence rows hold metadata only; file bytes are never stored
// here (a future blob store would be referenced through `storageKey`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Enums
 */
/**
 * ------------------------------------------------------------------
 */

enum FraudCategory {
  upi_payment
  phishing
  banking_card
  impersonation
  account_takeover
  investment
  shopping
  other
}

enum CaseStatus {
  draft
  reported
  analysis_in_progress
  action_plan_ready
  user_action_required
  reporting_in_progress
  resolved
  archived
}

enum TriState {
  yes
  no
  unsure
}

enum Currency {
  INR
  USD
  EUR
  GBP
  AED
}

enum EvidenceKind {
  image
  pdf
  text
  other
}

enum AgentId {
  incident
  containment
  evidence
  recovery
}

enum AgentStatus {
  not_started
  analyzing
  awaiting_information
  completed
  needs_review
}

enum FindingSource {
  mock_analysis
  /// Produced by a Microsoft Foundry model. Never verified.
  ai_analysis
  user_supplied
  verified_guidance
  unverified_assumption
  /// Computed by the deterministic cross-source matcher (src/lib/evidence). Not AI, not verified.
  evidence_check
}

enum Confidence {
  low
  medium
  high
}

enum AnalysisRunStatus {
  running
  completed
  cancelled
  failed
}

/// Which implementation produced an analysis run.
enum AnalysisEngine {
  mock
  foundry
}

enum ActionPriority {
  urgent
  high
  normal
}

enum ActionStatus {
  pending
  in_progress
  completed
}

/// suggested: proposed by STOPLOSS AI, the user does it.
/// external: a process outside the app (bank, police) the app cannot verify.
enum ActionOrigin {
  suggested
  external
}

enum TimelineActor {
  user
  agent
  system
}

enum TimelineTone {
  neutral
  success
  warning
  info
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Evidence Intelligence enums
 */
/**
 * ------------------------------------------------------------------
 */

/// Whether facts have been extracted from an evidence item.
enum EvidenceProcessingStatus {
  not_processed
  processed
  /// Processed, but nothing usable was found.
  no_facts
  failed
  /// No extractor exists for this file type.
  unsupported
}

/// What kind of source a fact came from.
enum EvidenceSourceType {
  payment_screenshot
  sms_notification
  bank_statement
  chat_export
  /// What the person typed into the case form.
  case_details
  other_document
}

/// transaction: the record describes a payment. context: it only mentions one (e.g. a chat).
enum EvidenceRecordRole {
  transaction
  context
}

enum ExtractionMethod {
  vision_model
  statement_parser
  chat_parser
  user_entry
}

enum EvidenceFactType {
  amount
  transaction_reference
  transaction_datetime
  recipient_upi_id
  recipient_phone
  recipient_account
  recipient_name
  payment_method
  transaction_direction
  transaction_status
  message_event
  other
}

enum TimePrecision {
  minute
  day
}

/// The person's review of one fact. "Conflicted" is derived from matches, never stored here.
enum FactReviewStatus {
  unreviewed
  user_confirmed
  user_rejected
  user_corrected
  needs_verification
}

enum MatchOutcome {
  match
  partial_match
  conflict
  insufficient_evidence
  unrelated
}

enum EvidenceRelation {
  corroborates
  conflicts_with
  possibly_same_transaction
  related_context
}

enum MatchReviewStatus {
  open
  reviewed
  deferred
}

enum EvidenceReviewAction {
  confirm
  reject
  correct
  mark_needs_verification
  reset
  review_conflict
  defer_conflict
  /// Re-extraction found a different value for a fact the person had reviewed.
  reextracted_changed
}

enum ResourceKind {
  portal
  helpline
  provider
  regulator
  telecom
}

/**
 * ------------------------------------------------------------------
 */
/**
 * People
 */
/**
 * ------------------------------------------------------------------
 */

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  displayName       String
  preferredLanguage String   @default("English")
  city              String?
  /// Masked number for display only, e.g. "+91 ••••• ••210". Never a full number.
  phoneHint         String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  incidents Incident[]

  @@map("users")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Cases
 */
/**
 * ------------------------------------------------------------------
 */

model Incident {
  id               String        @id @default(uuid()) @db.Uuid
  /// Human-readable case reference, e.g. SL-2610-4821.
  reference        String        @unique @db.VarChar(20)
  userId           String        @db.Uuid
  title            String        @db.VarChar(120)
  category         FraudCategory
  description      String        @db.VarChar(2000)
  amount           Decimal       @db.Decimal(14, 2)
  currency         Currency      @default(INR)
  occurredAt       DateTime      @db.Timestamptz(3)
  reportedAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  paymentMethod    String        @db.VarChar(60)
  /// UTR / RRN / UPI ref. Validated upstream to reject card numbers and secrets.
  transactionRef   String?       @db.VarChar(60)
  /// Where the money went: UPI ID, phone number or account, as the person reported it.
  counterparty     String?       @db.VarChar(120)
  hasAccountAccess TriState
  ongoing          TriState?
  status           CaseStatus    @default(reported)
  /// True for clearly fictional sample rows created by the seed script.
  isSample         Boolean       @default(false)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes        CaseNote[]
  evidence     EvidenceItem[]
  actions      ActionItem[]
  agentStates  AgentState[]
  analysisRuns AnalysisRun[]
  findings     AgentFinding[]
  timeline     TimelineEvent[]
  facts        EvidenceFact[]
  transactions TransactionCandidate[]
  matches      EvidenceMatch[]
  reviewEvents EvidenceReviewEvent[]

  @@index([userId, status])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("incidents")
}

model CaseNote {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  body       String   @db.VarChar(1000)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("case_notes")
}

/// Metadata about a file the user added. File contents stay on the user's device.
model EvidenceItem {
  id          String       @id @default(uuid()) @db.Uuid
  incidentId  String       @db.Uuid
  name        String       @db.VarChar(255)
  kind        EvidenceKind
  mimeType    String       @db.VarChar(127)
  /// Size in bytes.
  size        Int
  description String?      @db.VarChar(500)
  /// Short excerpt of a .txt file, if the user chose to share one.
  textPreview String?      @db.VarChar(2000)
  /// Reserved for a future blob store (e.g. Azure Blob). Null = file not uploaded.
  storageKey  String?
  sha256      String?      @db.Char(64)
  isSample    Boolean      @default(false)
  addedAt     DateTime     @default(now()) @db.Timestamptz(3)

  /// Evidence Intelligence: whether facts were extracted (the file itself is still never stored).
  processingStatus EvidenceProcessingStatus @default(not_processed)
  processedAt      DateTime?                @db.Timestamptz(3)
  /// Safe, user-facing reason when processing failed. Never model output or file content.
  processingError  String?                  @db.VarChar(200)

  incident Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  facts    EvidenceFact[]

  @@index([incidentId, addedAt(sort: Desc)])
  @@map("evidence_items")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Evidence Intelligence
 */
/**
 * ------------------------------------------------------------------
 */

/// One fact as one source states it (a screenshot, a statement row, a chat message or the case form).
/// Values are screened before storage: never OTPs, PINs, CVVs or full card numbers.
model EvidenceFact {
  id               String             @id @default(uuid()) @db.Uuid
  incidentId       String             @db.Uuid
  /// Null for facts the person typed into the case form.
  evidenceId       String?            @db.Uuid
  transactionId    String?            @db.Uuid
  /// Stable identity within the case (source + location + type). Re-extraction upserts by it.
  factKey          String             @db.VarChar(200)
  /// Facts that one source presents together (one screenshot, one statement row, one message).
  recordKey        String             @db.VarChar(160)
  recordRole       EvidenceRecordRole
  factType         EvidenceFactType
  sourceType       EvidenceSourceType
  extractionMethod ExtractionMethod
  /// Model deployment + prompt version, or parser version.
  extractorVersion String?            @db.VarChar(80)
  /// The value as found, after screening.
  rawValue         String             @db.VarChar(200)
  /// Comparison value (see src/lib/evidence/normalize.ts).
  normalizedValue  String             @db.VarChar(200)
  /// Amounts in minor units (paise), so comparisons never use floating point.
  amountMinor      BigInt?
  currency         Currency?
  occurredAt       DateTime?          @db.Timestamptz(3)
  timePrecision    TimePrecision?
  /// e.g. "Page 1 · row 4" or "Message 5 · 15 Oct 2026, 2:36 pm". Null when the source gives none.
  sourceLocation   String?            @db.VarChar(120)
  reviewStatus     FactReviewStatus   @default(unreviewed)
  /// The person's correction. The extracted rawValue is kept alongside it.
  correctedValue   String?            @db.VarChar(200)
  reviewedAt       DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  incident    Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidence    EvidenceItem?         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  transaction TransactionCandidate? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  matchesA    EvidenceMatch[]       @relation("MatchFactA")
  matchesB    EvidenceMatch[]       @relation("MatchFactB")
  reviews     EvidenceReviewEvent[]

  @@unique([incidentId, factKey])
  @@index([incidentId, factType])
  @@index([evidenceId])
  @@index([transactionId])
  @@map("evidence_facts")
}

/// A possible transaction assembled from facts by the deterministic matcher.
model TransactionCandidate {
  id           String   @id @default(uuid()) @db.Uuid
  incidentId   String   @db.Uuid
  /// Stable key from the matcher, so reprocessing updates rather than duplicates.
  candidateKey String   @db.VarChar(200)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  incident Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  facts    EvidenceFact[]
  matches  EvidenceMatch[]

  @@unique([incidentId, candidateKey])
  @@map("transaction_candidates")
}

/// The result of comparing two facts under one documented rule.
model EvidenceMatch {
  id             String            @id @default(uuid()) @db.Uuid
  incidentId     String            @db.Uuid
  /// Rule + fact ids + compared values. A changed value yields a new key, so a review never carries over to different data.
  matchKey       String            @db.VarChar(300)
  ruleId         String            @db.VarChar(60)
  outcome        MatchOutcome
  relation       EvidenceRelation
  factAId        String            @db.Uuid
  factBId        String            @db.Uuid
  transactionId  String?           @db.Uuid
  explanation    String            @db.VarChar(600)
  uncertainty    String?           @db.VarChar(300)
  requiresReview Boolean           @default(false)
  reviewStatus   MatchReviewStatus @default(open)
  reviewedAt     DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  incident    Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  factA       EvidenceFact          @relation("MatchFactA", fields: [factAId], references: [id], onDelete: Cascade)
  factB       EvidenceFact          @relation("MatchFactB", fields: [factBId], references: [id], onDelete: Cascade)
  transaction TransactionCandidate? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  reviews     EvidenceReviewEvent[]

  @@unique([incidentId, matchKey])
  @@index([factAId])
  @@index([factBId])
  @@map("evidence_matches")
}

/// Audit trail of the person's reviews. Records what changed, never the values themselves.
model EvidenceReviewEvent {
  id         String               @id @default(uuid()) @db.Uuid
  incidentId String               @db.Uuid
  factId     String?              @db.Uuid
  matchId    String?              @db.Uuid
  action     EvidenceReviewAction
  fromStatus String?              @db.VarChar(40)
  toStatus   String?              @db.VarChar(40)
  actor      TimelineActor        @default(user)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)

  incident Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fact     EvidenceFact?  @relation(fields: [factId], references: [id], onDelete: SetNull)
  match    EvidenceMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("evidence_review_events")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Action plan
 */
/**
 * ------------------------------------------------------------------
 */

model ActionItem {
  id           String         @id @default(uuid()) @db.Uuid
  incidentId   String         @db.Uuid
  /// Stable playbook key so reruns don't duplicate actions.
  key          String         @db.VarChar(60)
  title        String
  explanation  String
  priority     ActionPriority
  status       ActionStatus   @default(pending)
  origin       ActionOrigin
  timing       String
  instructions String[]
  requiredInfo String[]
  /// Keys of other actions in the same plan that should come first.
  dependsOn    String[]
  resourceId   String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  completedAt  DateTime?      @db.Timestamptz(3)

  incident Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  resource OfficialResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([incidentId, key])
  @@index([incidentId, status])
  @@map("action_items")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Agents
 */
/**
 * ------------------------------------------------------------------
 */

/// One analysis pass over an incident (all four agents). Kept as history.
model AnalysisRun {
  id            String            @id @default(uuid()) @db.Uuid
  incidentId    String            @db.Uuid
  engine        AnalysisEngine    @default(mock)
  /// Foundry model deployment used (null for template runs).
  model         String?           @db.VarChar(120)
  /// Version of the agent instructions, so stored findings can be traced to a prompt.
  promptVersion String?           @db.VarChar(40)
  status        AnalysisRunStatus @default(running)
  startedAt     DateTime          @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?         @db.Timestamptz(3)
  error         String?

  incident Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  findings AgentFinding[]

  @@index([incidentId, startedAt(sort: Desc)])
  @@map("analysis_runs")
}

/// Current status of each agent for an incident (exactly one row per agent).
model AgentState {
  incidentId  String      @db.Uuid
  agentId     AgentId
  status      AgentStatus @default(not_started)
  currentTask String
  startedAt   DateTime?   @db.Timestamptz(3)
  completedAt DateTime?   @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@id([incidentId, agentId])
  @@map("agent_states")
}

model AgentFinding {
  id         String        @id @default(uuid()) @db.Uuid
  incidentId String        @db.Uuid
  runId      String?       @db.Uuid
  agentId    AgentId
  title      String
  detail     String
  /// Where the content comes from — always shown next to the finding.
  source     FindingSource
  /// Optional list content (checklists, missing items, inventory).
  items      String[]
  confidence Confidence?
  /// Display order within one agent's output.
  position   Int           @default(0)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  incident Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  run      AnalysisRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([incidentId, agentId, position])
  @@map("agent_findings")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Timeline / notifications
 */
/**
 * ------------------------------------------------------------------
 */

model TimelineEvent {
  id         String        @id @default(uuid()) @db.Uuid
  incidentId String        @db.Uuid
  at         DateTime      @default(now()) @db.Timestamptz(3)
  actor      TimelineActor
  agentId    AgentId?
  title      String
  detail     String?
  tone       TimelineTone  @default(neutral)
  /// Set when the user dismisses it from the notifications menu.
  readAt     DateTime?     @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, at(sort: Desc)])
  @@index([at(sort: Desc)])
  @@map("timeline_events")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Reference data
 */
/**
 * ------------------------------------------------------------------
 */

/// Official reporting and support channels. Reference data, not user data.
model OfficialResource {
  /// Stable slug, e.g. "ncrp", "helpline-1930".
  id           String       @id @db.VarChar(60)
  organization String
  name         String
  purpose      String
  relevance    String
  kind         ResourceKind
  url          String?
  phone        String?      @db.VarChar(30)
  note         String?
  /// Null = not yet verified. Never set without actually checking the source.
  verifiedAt   DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  actions ActionItem[]

  @@map("official_resources")
}

# Local development only. Matches docker-compose.yml — never commit real credentials.
DATABASE_URL="postgresql://stoploss:stoploss@localhost:5435/stoploss?schema=public"
# Milliseconds between simulated agent steps.
ANALYSIS_STEP_MS=1400

# --- Microsoft Foundry (optional) --------------------------------------------
# "auto"    uses Foundry when FOUNDRY_ENDPOINT and FOUNDRY_DEPLOYMENT are set, otherwise templates.
# "foundry" same as auto, but warns at startup if the configuration is incomplete.
# "mock"    always uses the deterministic template agents (no model calls) — use for local testing.
ANALYSIS_ENGINE=auto
# Your Foundry project or resource endpoint. Any of these forms works:
#   https://<resource>.services.ai.azure.com/api/projects/<project>
#   https://<resource>.services.ai.azure.com/openai/v1/
#   https://<resource>.openai.azure.com/openai/v1/
FOUNDRY_ENDPOINT=
# The DEPLOYMENT name from Foundry → Models + endpoints (not the catalog model name), e.g. gpt-5.4-mini
FOUNDRY_DEPLOYMENT=
# Optional. Leave empty to use Microsoft Entra ID (`az login` locally, managed identity in Azure).
FOUNDRY_API_KEY=
# Per-call timeout for each agent (1000–600000 ms).
FOUNDRY_TIMEOUT_MS=60000
# Cost control: max Foundry-backed analysis runs per user per hour (HTTP 429 beyond this).
FOUNDRY_MAX_RUNS_PER_HOUR=20
# Screenshot reads (Read details) per user per hour.
SCREENSHOT_MAX_READS_PER_HOUR=30
